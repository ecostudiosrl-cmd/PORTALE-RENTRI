# ============================================
# PORTALE RENTRI - Variabili Ambiente
# ============================================
# Copia in .env.local (Vercel) e .env (sviluppo locale)

# SUPABASE
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_ANON_KEY

# BREVO (SendInBlue)
BREVO_API_KEY=YOUR_BREVO_API_KEY

# EMAIL DEFAULT
FROM_EMAIL=noreply@tuodominio.it
FROM_NAME=RENTRI - Notifiche Rifiuti

# STORAGE (Supabase)
SUPABASE_STORAGE_BUCKET=rentri-documents

# Optional: Webhook secret (per sicurezza)
WEBHOOK_SECRET=your_secret_key_here
